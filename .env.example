# Copy to .env and fill in. These are read server-side only (Vite dev server).
# Never prefix them with VITE_ — that would bundle them into client JavaScript.

# Required: your OpenRouter API key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# Optional: any OpenRouter model slug (https://openrouter.ai/models).
# Leave empty to use the default defined in server/openrouter.ts.
OPENROUTER_MODEL=
